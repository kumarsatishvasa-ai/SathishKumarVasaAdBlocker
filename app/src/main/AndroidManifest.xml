<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for the upstream DNS resolver. -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Required for the foreground VPN service. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required when using the specialUse foreground-service type. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SathishKumarVasaAdBlocker">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!--
             DNS filtering VPN service.

             BIND_VPN_SERVICE is required by Android for
             applications that implement VpnService.
        -->
        <service
            android:name=".DnsVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">

            <intent-filter>

                <action
                    android:name="android.net.VpnService" />

            </intent-filter>

            <!-- Allow Android Always-on VPN configuration. -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />

            <!-- Explanation required for specialUse FGS. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="dns_filtering" />

        </service>

    </application>

</manifest>
