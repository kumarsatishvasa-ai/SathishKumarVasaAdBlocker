<manifest xmlns:android="http://schemas.android.com/apk/res/android">

<!-- Internet access for downloading filter lists and contacting DNS --> <uses-permission android:name="android.permission.INTERNET" />

<!-- Foreground VPN service --> <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

<!-- Android 14+ special-use foreground service --> <uses-permission android:name="android.permission.FOREGROUNDSERVICESPECIAL_USE" />

<!-- Android 13+ notifications --> <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<application android:allowBackup="true" android:icon="@android:drawable/symdefappicon" android:label="@string/appname" android:roundIcon="@android:drawable/symdefapp_icon" android:supportsRtl="true" android:theme="@style/Theme.AdBlocker">

<!-- Main application screen --> <activity android:name=".MainActivity" android:exported="true">

<intent-filter> <action android:name="android.intent.action.MAIN" /> <category android:name="android.intent.category.LAUNCHER" /> </intent-filter>

</activity>

<!-- Local DNS-filtering VPN --> <service android:name=".AdBlockVpnService" android:exported="false" android:permission="android.permission.BINDVPNSERVICE" android:foregroundServiceType="specialUse">

<intent-filter> <action android:name="android.net.VpnService" /> </intent-filter>

<property android:name="android.app.PROPERTYSPECIALUSEFGSSUBTYPE" android:value="dnsfilteringvpn" />

</service>

</application>

</manifest>
